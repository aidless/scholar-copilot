# 复制为 .env 后填写。所有密钥只进环境变量——任何 API 响应不得回显 secret 字段（THREAT-MODEL 规则 3）

# ---- 后端：基础 ----
SC_DATABASE_URL=postgresql+asyncpg://scholar:scholar@postgres:5432/scholar
SC_REDIS_URL=redis://redis:6379/0
SC_JWT_SECRET=            # 必改：openssl rand -hex 32（<32 字节会告警）
SC_JWT_EXPIRE_DAYS=7
SC_SMS_HMAC_KEY=          # 必改：openssl rand -hex 32（短信签名 HMAC 密钥）
SC_SMS_DEV_MODE=false     # 演示可设 true：验证码固定 000000（生产务必 false）
SC_PRIMARY_DOMAIN=localhost:3000

# ---- 后端：LLM（OpenAI 兼容即可：DeepSeek/Qwen/vLLM/Ollama） ----
SC_LLM_PROVIDER=openai_compat
SC_LLM_BASE_URL=https://api.deepseek.com/v1
SC_LLM_API_KEY=
SC_LLM_MODEL=deepseek-chat

# ---- 后端：业务/安全 ----
SC_FREE_OUTLINE_LIMIT=3             # 免费大纲次数（服务端强制）
SC_PAYMENT_MODE=mock                # mock=确认端点模拟回调；manual=管理员人工核对回执
SC_ADMIN_INITIAL_LOGIN=admin        # 初始管理员账号
SC_ADMIN_INITIAL_PASSWORD=          # 留空=不创建；建议首次填强随机口令，登录后改密并置空
SC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 运营日报定时推送（arq cron；关闭时不发任何外部请求）
# 文献源凭据（都可选，无凭据也能跑）
SC_OPENALEX_MAILTO=               # 填邮箱进 OpenAlex 礼貌池，配额更稳
SC_OPENALEX_API_KEY=
SC_SEMANTIC_SCHOLAR_API_KEY=
SC_PUBMED_ENABLED=true            # 医学/生命科学库；只要 DOI 库可关掉
SC_PUBMED_API_KEY=                # NCBI key：3 req/s → 10 req/s
SC_PUBMED_EMAIL=

SC_REPORT_PUSH_ENABLED=false
SC_REPORT_WEBHOOK_URL=            # 企业微信/飞书/Slack 机器人地址（接受 JSON POST）
SC_REPORT_PUSH_HOUR=9             # 每天几点推（UTC 小时）
SC_REPORT_PUSH_DAYS=1             # 汇总窗口天数
# 微信webhook 为空时走邮件通道（二选一，webhook 优先）
SC_REPORT_EMAIL_TO=               # 收件人，多个用逗号分隔；空则不发邮件
SC_SMTP_HOST=
SC_SMTP_PORT=587
SC_SMTP_USER=
SC_SMTP_PASSWORD=
SC_SMTP_FROM=                     # 发件人地址；空则用 SC_SMTP_USER
SC_SMTP_STARTTLS=true             # 587 一般 true；465(SSL) 需 SC_SMTP_SSL=true 且 STARTTLS=false
SC_SMTP_SSL=false

SC_RATE_LIMIT_BACKEND=memory       # memory（进程内，单实例）| redis（共享计数，多实例/多 worker 必选）
SC_RATE_LIMIT_LOGIN_PER_MINUTE=20   # 登录/注册（防撞库）
SC_RATE_LIMIT_LLM_PER_MINUTE=10     # 改写/体检（LLM 成本保护）
SC_RATE_LIMIT_SEARCH_PER_MINUTE=30  # 文献检索（上游限流保护）
SC_DB_AUTO_CREATE=true              # 演示=true 启动建表；生产=false + alembic upgrade head

# ---- docker compose（postgres/redis 容器口令） ----
POSTGRES_PASSWORD=scholar
