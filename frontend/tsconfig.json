{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "es2022"], "strict": true,
    "jsx": "preserve", "module": "esnext", "moduleResolution": "bundler",
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "incremental": true, "plugins": [{ "name": "next" }]
  },
  "include": ["app", "next-env.d.ts"]
}
